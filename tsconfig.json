{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Don't type-check dependencies' declarations: Homebridge 2's Matter packages rely on browser (DOM) types,
    // which this Node-only plugin deliberately doesn't include
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
