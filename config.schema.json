{
  "pluginAlias": "FaberRangeHood",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": ["auth_mode", "device_ids"],
    "additionalProperties": false,
    "properties": {
      "auth_mode": {
        "title": "Auth Mode",
        "type": "string",
        "default": "token",
        "oneOf": [
          {
            "title": "Token",
            "enum": [
              "token"
            ]
          }
        ]
      },
      "refresh_token": {
        "title": "Refresh Token",
        "type": "string",
        "placeholder": "eyJraWQiO...",
        "condition": {
          "functionBody": "return model.auth_mode === 'token';"
        }
      },
      "device_ids": {
        "type": "array",
        "items": {
          "title": "Device ID",
          "type": "string",
          "placeholder": "PINb12jghtk23D9WEoweif"
        }
      }
    }
  }
}
