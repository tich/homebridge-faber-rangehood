{
  "pluginAlias": "FaberRangeHood",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": ["auth_mode", "refresh_token"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Faber Range Hood"
      },
      "auth_mode": {
        "title": "Auth Mode",
        "type": "string",
        "default": "token",
        "oneOf": [
          {
            "title": "Token",
            "enum": [
              "token"
            ]
          }
        ]
      },
      "refresh_token": {
        "title": "Refresh Token",
        "type": "string",
        "minLength": 1,
        "placeholder": "eyJraWQiO...",
        "condition": {
          "functionBody": "return model.auth_mode === 'token';"
        }
      },
      "fallback_poll_interval": {
        "title": "Fallback Poll Interval (seconds)",
        "description": "The hoods' status is pushed to Homebridge as it changes. As a safety net, it's also polled this often. When push updates aren't available, it's polled every few seconds instead",
        "type": "integer",
        "minimum": 30,
        "default": 300
      },
      "devices": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "name": {
              "title": "Device Name (Optional)",
              "description": "Changing it renames the device and its light, fan, and filters in the Home app, replacing any names set there",
              "type": "string",
              "default": "",
              "placeholder": ""
            },
            "id": {
              "title": "Device ID",
              "type": "string",
              "minLength": 1,
              "placeholder": "PINb12jghtk23D9WEoweif"
            }
          }
        }
      }
    }
  }
}
